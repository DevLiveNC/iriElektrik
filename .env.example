# Yalnızca değişken adları listelenir; değer yazılmaz.
# Üretimde (Vercel) bu değerleri Vercel Project Settings > Environment Variables
# bölümünden tanımlayın. .env.local dosyasını repoya eklemeyin.

# PostgreSQL bağlantısı (ör. Neon). Tanımlı değilse yerel JSON deposu kullanılır
# (yalnızca geliştirme/önizleme içindir; Vercel'de kalıcı değildir).
DATABASE_URL=

# Yönetici oturumu (kayıt ekranı yoktur; tek yönetici).
# ADMIN_PASSWORD_HASH: bcrypt özeti. Üretmek için:
#   node -e "const b=require('bcryptjs');b.hash(process.argv[1],12).then(h=>console.log(h))" 'GÜÇLÜ_PAROLA'
# ADMIN_PASSWORD yalnızca yerel geliştirme içindir; üretimde kullanmayın.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# Oturum çerezi imzalama anahtarı (en az 32 karakter, rastgele).
AUTH_SECRET=

# Vercel Blob (fotoğraf depolama). Tanımlı değilse public/uploads kullanılır.
BLOB_READ_WRITE_TOKEN=

# Genel site adresi (canonical/OG/sitemap için). Örn. https://ornek.com
NEXT_PUBLIC_SITE_URL=
